---
import { getEntry, render, getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ExpertiseSection from "../components/ExpertiseSection.astro"
import { PAGES } from "../config";

const bioEntry = await getEntry("bio", "bio");
const { Content: BioContent } = bioEntry
    ? await render(bioEntry)
    : { Content: null };

const bio = bioEntry?.data;
---

<BaseLayout title={PAGES.home.title}>
	<div class="container-narrow">
		{
			(PAGES.home.title || PAGES.home.subtitle) && (
				<header class="page-header">
					{PAGES.home.title && (
						<h1 class="page-title">{PAGES.home.title}</h1>
					)}
					{PAGES.home.subtitle && (
						<p class="page-subtitle">{PAGES.home.subtitle}</p>
					)}
				</header>
			)
		}
		<div class="prose">
            {BioContent ? <BioContent /> : <p>Loading bio...</p>}
        </div>

        {bio?.expertise && (
            <ExpertiseSection items={bio.expertise} />
        )}
	</div>
</BaseLayout>
