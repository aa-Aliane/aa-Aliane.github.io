---
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BackLink from "../components/ui/BackLink.astro";
import Tag from "../components/ui/Tag.astro";
import Icon from "../components/ui/Icon.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { getDetailItem } from "../utils/adapters";
import { SITE } from "../config";

interface Props {
    collection: "publications" | "talks" | "projects" | "posts" | "teaching";
    id: string;
    readingTime?: string;
}

const { collection, id } = Astro.props;
const entry = (await getEntry(collection, id)) as any;

if (!entry) return Astro.redirect("/404");

const { Content, headings } = await render(entry);
const detail = getDetailItem(entry, collection);

const meta = [];
if (detail.date) meta.push({ label: "Date", value: detail.date, icon: "Calendar" });
if (detail.authors) meta.push({ label: "Author", value: detail.authors, icon: "User" });
if (detail.extraInput) {
    const icon = "Institution";
    const label = collection === "publications" ? "Journal" : collection === "talks" ? "Event" : collection === "teaching" ? "Institution" : "Info";
    meta.push({ label, value: detail.extraInput, icon });
}

const description = entry.data.description || detail.description || SITE.desc;
const ogImage = entry.data.image || SITE.ogImage;

// Only show TOC for posts that have headings
const tocHeadings = collection === "posts"
    ? headings.filter((h: any) => h.depth === 2 || h.depth === 3)
    : [];
const hasToc = tocHeadings.length > 0;
---

<BaseLayout title={detail.title} description={description} ogImage={ogImage} ogType="article">
    <div class="flex justify-between items-center mb-4">
        <BackLink href={detail.backHref} label={collection} />
        {detail.externalUrl && (
            <a href={detail.externalUrl} target="_blank" rel="noopener noreferrer" class="link">
                View external
            </a>
        )}
    </div>

    {hasToc ? (
        <div class="detail-with-toc">
            <article class="detail-article">
                <h1 class="page-title mb-4">{detail.title}</h1>

                {meta.length > 0 && (
                    <div class="card-meta mb-4">
                        {meta.map((m: any) => (
                            <span class="flex items-center gap-1">
                                <Icon name={m.icon} size={14} />
                                <span>{m.value}</span>
                            </span>
                        ))}
                    </div>
                )}

                {detail.tags && detail.tags.length > 0 && (
                    <div class="flex gap-2 flex-wrap mb-4">
                        {detail.tags.map((tag: string) => (
                            <Tag name={tag} size="sm" />
                        ))}
                    </div>
                )}

                <div class="prose">
                    <Content />
                </div>

                <slot name="share" />
                <slot name="footer" />
            </article>

            <aside class="detail-toc">
                <TableOfContents headings={tocHeadings} />
            </aside>
        </div>
    ) : (
        <article>
            <h1 class="page-title mb-4">{detail.title}</h1>

            {meta.length > 0 && (
                <div class="card-meta mb-4">
                    {meta.map((m: any) => (
                        <span class="flex items-center gap-1">
                            <Icon name={m.icon} size={14} />
                            <span>{m.value}</span>
                        </span>
                    ))}
                </div>
            )}

            {detail.tags && detail.tags.length > 0 && (
                <div class="flex gap-2 flex-wrap mb-4">
                    {detail.tags.map((tag: string) => (
                        <Tag name={tag} size="sm" />
                    ))}
                </div>
            )}

            <div class="prose">
                <Content />
            </div>

            <slot name="share" />
            <slot name="footer" />
        </article>
    )}
</BaseLayout>

<style>
    /* Two-column layout: article + TOC */
    .detail-with-toc {
        display: flex;
        align-items: flex-start;
        gap: 2.5rem;
    }

    .detail-article {
        flex: 1;
        min-width: 0; /* prevent overflow */
    }

    .detail-toc {
        /* Hidden on small/medium screens; shown from xl (~1280 px) upward.
           The outer layout already has a left sidebar, so we only show the
           TOC when there's enough horizontal space. */
        display: none;
        width: 200px;
        flex-shrink: 0;
        /*
         * Critical for sticky inside a flex container: the aside must NOT
         * stretch to the article's height, otherwise there is no room to
         * scroll and position:sticky on the inner <nav> never activates.
         */
        align-self: flex-start;
        position: sticky;
        top: 2rem;
    }

    /* Show TOC only on wide viewports */
    @media (min-width: 1280px) {
        .detail-toc {
            display: block;
        }
    }
</style>